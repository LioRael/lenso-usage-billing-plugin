{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"PostgreSQL Usage Billing Plugin configuration","type":"object",
  "required":["schema","database_url_secret","auth_issuer","auth_assertion_public_key","admin_callers","worker_callers","delivery_lease_seconds","max_delivery_attempts","max_meters_per_account"],
  "properties":{
    "schema":{"type":"string","minLength":1,"maxLength":63},"database_url_secret":{"type":"string","minLength":1,"maxLength":256},
    "auth_issuer":{"type":"string","minLength":1,"maxLength":256},"auth_assertion_public_key":{"type":"string","minLength":1,"maxLength":256},
    "admin_callers":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "worker_callers":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "delivery_lease_seconds":{"type":"integer","minimum":5,"maximum":3600},"max_delivery_attempts":{"type":"integer","minimum":1,"maximum":100},
    "max_meters_per_account":{"type":"integer","minimum":1,"maximum":200}
  },"additionalProperties":false
}
